#include <iostream>
#include <fstream>
#include <iomanip>
#include <string>

using namespace std;

class StudentPerformanceSystem {

private:

    struct Student {
        int id;
        string name;
        string dept;
        int semester;
        float cgpa;
        int credits;
        int year;
    };

    struct Node {
        Student data;
        Node* next;
    };

    Node* head;

    Node* createNode(Student s) {
        Node* temp = new Node;
        temp->data = s;
        temp->next = NULL;
        return temp;
    }

    void insertEnd(Node*& listHead, Student s) {
        Node* temp = createNode(s);

        if (listHead == NULL) {
            listHead = temp;
            return;
        }

        Node* curr = listHead;
        while (curr->next != NULL)
            curr = curr->next;

        curr->next = temp;
    }

    Node* copyList(Node* source) {
        Node* newHead = NULL;

        while (source != NULL) {
            insertEnd(newHead, source->data);
            source = source->next;
        }
        return newHead;
    }

    void bubbleSortByCGPA(Node* listHead) {
        bool swapped;
        Node* ptr;
        Node* last = NULL;

        if (listHead == NULL) return;

        do {
            swapped = false;
            ptr = listHead;

            while (ptr->next != last) {
                if (ptr->data.cgpa < ptr->next->data.cgpa ||
                   (ptr->data.cgpa == ptr->next->data.cgpa &&
                    ptr->data.credits < ptr->next->data.credits)) {

                    swap(ptr->data, ptr->next->data);
                    swapped = true;
                }
                ptr = ptr->next;
            }
            last = ptr;
        } while (swapped);
    }

    void selectionSortByYear(Node* listHead) {
        for (Node* i = listHead; i != NULL; i = i->next) {
            Node* min = i;

            for (Node* j = i->next; j != NULL; j = j->next) {
                if (j->data.year < min->data.year ||
                   (j->data.year == min->data.year &&
                    j->data.id < min->data.id)) {
                    min = j;
                }
            }
            swap(i->data, min->data);
        }
    }

    void deleteList(Node*& listHead) {
        while (listHead != NULL) {
            Node* temp = listHead;
            listHead = listHead->next;
            delete temp;
        }
    }

    void writeRankedByCGPA(Node* listHead) {
        ofstream out("ranked_by_cgpa.txt");

        out << "====================================================\n";
        out << "        STUDENTS RANKED BY CGPA\n";
        out << "====================================================\n";
        out << "Rank | ID     | Name              | Dept | Sem | CGPA | Credits | Year\n";
        out << "-----|--------|-------------------|------|-----|------|---------|------\n";

        int rank = 1;
        while (listHead != NULL) {
            out << setw(4) << rank++ << " | "
                << setw(6) << listHead->data.id << " | "
                << setw(18) << listHead->data.name << " | "
                << setw(4) << listHead->data.dept << " | "
                << setw(3) << listHead->data.semester << " | "
                << fixed << setprecision(2) << setw(4) << listHead->data.cgpa << " | "
                << setw(7) << listHead->data.credits << " | "
                << listHead->data.year << endl;

            listHead = listHead->next;
        }

        out.close();
    }

    void writeSortedByEnrollment(Node* listHead) {
        ofstream out("sorted_by_enrollment.txt");

        int currentYear = -1;
        float sum = 0;
        int count = 0;

        while (listHead != NULL) {
            if (listHead->data.year != currentYear) {
                if (count > 0) {
                    out << "Average CGPA: "
                        << fixed << setprecision(2)
                        << (sum / count) << "\n\n";
                }

                currentYear = listHead->data.year;
                sum = 0;
                count = 0;

                out << "Enrollment Year: " << currentYear << endl;
                out << "----------------------------\n";
            }

            out << listHead->data.id << "  "
                << listHead->data.name << "  "
                << listHead->data.cgpa << endl;

            sum += listHead->data.cgpa;
            count++;
            listHead = listHead->next;
        }

        if (count > 0)
            out << "Average CGPA: "
                << fixed << setprecision(2)
                << (sum / count) << endl;

        out.close();
    }

    void writePerformanceTiers(Node* listHead) {
        ofstream out("performance_tiers.txt");

        out << "===== PERFORMANCE TIERS =====\n\n";

        while (listHead != NULL) {
            string tier;

            if (listHead->data.cgpa >= 3.70) tier = "Elite Tier";
            else if (listHead->data.cgpa >= 3.30) tier = "High Achievers";
            else if (listHead->data.cgpa >= 3.00) tier = "Good Standing";
            else if (listHead->data.cgpa >= 2.50) tier = "Satisfactory";
            else tier = "Needs Improvement";

            out << tier << " : "
                << listHead->data.name << " ("
                << listHead->data.cgpa << ")\n";

            listHead = listHead->next;
        }

        out.close();
    }

public:

    StudentPerformanceSystem() {
        head = NULL;
    }

    void loadData() {
        ifstream in("students_data.txt");

        if (!in) {
            cout << "Input file not found.\n";
            return;
        }

        int n;
        in >> n;

        for (int i = 0; i < n; i++) {
            Student s;
            in >> s.id;
            in.ignore();
            getline(in, s.name, ' ');
            getline(in, s.name, ' ');
            in >> s.dept >> s.semester >> s.cgpa >> s.credits >> s.year;

            insertEnd(head, s);
        }

        in.close();
    }

    void generateReports() {
        Node* cgpaList = copyList(head);
        bubbleSortByCGPA(cgpaList);
        writeRankedByCGPA(cgpaList);

        Node* yearList = copyList(head);
        selectionSortByYear(yearList);
        writeSortedByEnrollment(yearList);

        writePerformanceTiers(cgpaList);

        deleteList(cgpaList);
        deleteList(yearList);
    }

    ~StudentPerformanceSystem() {
        deleteList(head);
    }
};

int main() {
    StudentPerformanceSystem system;
    system.loadData();
    system.generateReports();
    cout<<"data sorted and copied completely";
    return 0;
}

